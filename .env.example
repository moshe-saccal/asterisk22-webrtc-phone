# ---------------------------------------------------------------------------
# Address browsers and SIP phones use to reach this machine (LAN or public IP).
# It is advertised in ICE candidates and SDP. scripts/setup.sh detects it.
EXTERNAL_IP=

# Web phone (HTTPS) and HTTP->HTTPS redirect ports on the host.
HTTPS_PORT=8443
HTTP_PORT=8080

# RTP/ICE port range. Published 1:1 by docker compose, so keep it modest
# (each call leg uses one port with BUNDLE + rtcp-mux).
RTP_PORT_START=10000
RTP_PORT_END=10099

# Optional STUN/TURN used by Asterisk itself (host:port). Only needed when
# Asterisk sits behind NAT that EXTERNAL_IP does not describe.
STUN_SERVER=
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ICE servers handed to the browsers (JSON array of RTCIceServer).
# Leave as [] on a LAN. Example for remote users:
# CLIENT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
CLIENT_ICE_SERVERS=[]
